#!/bin/bash
#SBATCH --job-name=TrainSagittal
#SBATCH --output=slurm_output_sagittal_mamba_fptt%j.out
#SBATCH --error=slurm_output_sagittal_mamba_fptt%j.err
#SBATCH --time=3-00:00:00
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --gpus=4
#SBATCH --mem=64G

# === 1. Load environment ===
echo "Loading modules..."
module purge
module load python/3.9
module load cuda/11.8
module load cudnn/8.2.4
echo "Modules loaded."

# === 1.1 Activate virtual environment ===
source "$SLURM_SUBMIT_DIR/.venv/bin/activate"
echo "Virtual environment activated: $VIRTUAL_ENV"


# === 2. Define and Create Output Directory ===
# I percorsi sono relativi a $SLURM_SUBMIT_DIR (la directory da cui sottometti il job)
RUN_ID="brats23_sagittal_fold1_orig_${SLURM_JOB_ID}"
OUTPUT_DIR_PERSISTENT="experiments/$RUN_ID"
mkdir -p "$OUTPUT_DIR_PERSISTENT"
export SNN_FPTT_RUN_ID="$RUN_ID"
export SNN_FPTT_RUN_DIR="$SLURM_SUBMIT_DIR/$OUTPUT_DIR_PERSISTENT"
echo "Output will be saved to: $SNN_FPTT_RUN_DIR"

# === 3. Define Data Directory ===
# Assicurati che questo percorso sia corretto rispetto a $SLURM_SUBMIT_DIR
# e a come train_h100_np.py si aspetta di trovare i dati.
# Se train_h100_np.py costruisce 'slices_output_png/sagittal' da args.data_dir,
# allora args.data_dir dovrebbe essere la directory genitore di 'slices_output_png'.
# Esempio: se i tuoi dati sono in $SLURM_SUBMIT_DIR/data_root/slices_output_png/...
# DATA_INPUT_DIR="data_root"
# Se i tuoi dati sono in $SLURM_SUBMIT_DIR/data/BraTS-GLI-2024/slices_output_png/...
DATA_INPUT_DIR="data/" # Come nel tuo script originale
echo "Data input directory assumed to be: $SLURM_SUBMIT_DIR/$DATA_INPUT_DIR"


# === 4. Run your script ===
echo "Starting Python training script..."
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export PYTHONUNBUFFERED=1

NUM_PROCESSES="${SLURM_GPUS_ON_NODE:-1}"
case "$NUM_PROCESSES" in
    ''|*[!0-9]*|0)
        echo "Invalid SLURM_GPUS_ON_NODE='$NUM_PROCESSES'; using one process."
        NUM_PROCESSES=1
        ;;
esac

ACCELERATE_ARGS=(
    --num_machines 1
    --num_processes "$NUM_PROCESSES"
    --mixed_precision no
)
if (( NUM_PROCESSES > 1 )); then
    ACCELERATE_ARGS+=(--multi_gpu)
fi

echo "Launching Accelerate with $NUM_PROCESSES process(es)."
accelerate launch "${ACCELERATE_ARGS[@]}" \
    snn_fptt.py \
    --config "$SLURM_SUBMIT_DIR/experiments_snn_fptt.yaml"

